  "components": {
    "schemas": {
      "AIMessageRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text"
          },
          "channel": {
            "$ref": "#/components/schemas/Channel",
            "default": "app"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AIMessageRequest",
        "description": "Mensaje recibido desde un canal compatible con el asistente."
      },
      "AIMessageResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "awaiting_confirmation": {
            "type": "boolean",
            "title": "Awaiting Confirmation"
          }
        },
        "type": "object",
        "required": [
          "text",
          "awaiting_confirmation"
        ],
        "title": "AIMessageResponse",
        "description": "Respuesta del asistente."
      },
      "Channel": {
        "type": "string",
        "enum": [
          "telegram",
          "app"
        ],
        "title": "Channel",
        "description": "Medio por el que llega la solicitud."
      },
      "CreateReminderRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled At"
          },
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          }
        },
        "type": "object",
        "required": [
          "message",
          "scheduled_at",
          "task_id"
        ],
        "title": "CreateReminderRequest"
      },
      "EditReminderRequest": {
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          }
        },
        "type": "object",
        "title": "EditReminderRequest"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Cuerpo devuelto por el adaptador cuando la petición falla."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginResponse": {
