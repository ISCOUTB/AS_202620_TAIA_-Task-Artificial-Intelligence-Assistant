# Plantilla de configuración local de TAIA.
#
# Copie este archivo a `backend/.env` y reemplace los valores. `backend/.env`
# está en .gitignore y no debe versionarse nunca.
#
# NO pegue aquí una contraseña real de producción. Esta plantilla se versiona, así
# que cualquier valor que escriba en ella queda publicado en el historial.

# -- Base de datos -------------------------------------------------------
# Obligatoria. La usa backend/app/shared/adapters/outbound/database.py al
# importarse, es decir, en cualquier comando del proyecto.
#
# Un PostgreSQL local desechable:
#   postgresql+psycopg://usuario@localhost:5432/taia
#
# O una instancia administrada, con el juego de credenciales que esa instancia
# entregue. Nunca reutilice aquí las credenciales de producción.
DATABASE_URL=postgresql+psycopg://usuario@localhost:5432/taia

# Obligatoria solo para ejecutar las pruebas. DEBE apuntar a una base distinta
# de la de desarrollo: backend/tests/conftest.py ejecuta
# `alembic downgrade base` y `TRUNCATE` al iniciar la sesión de pruebas.
TEST_DATABASE_URL=postgresql+psycopg://usuario@localhost:5432/taia_test

# -- Proveedor de lenguaje (Gemini) ---------------------------------------
# Sin esta variable el proceso NO arranca: la composición ocurre en app/main.py.
GEMINI_API_KEY=
# Opcional. Si se omite, el adaptador usa su modelo por defecto.
GEMINI_MODEL=

# -- Sesiones -------------------------------------------------------------
# Obligatoria en cualquier entorno compartido. Genere un valor aleatorio largo;
# un secreto corto o predecible permite a cualquiera falsificar un token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TAIA_JWT_SECRET=cambie-esto-por-un-valor-aleatorio-largo

# -- Telegram -------------------------------------------------------------
# Opcionales. Sin ellos el bot de Telegram no responde, pero el resto del
# asistente funciona igual.
TAIA_TELEGRAM_BOT_TOKEN=
TAIA_TELEGRAM_BOT_USERNAME=taia_bot