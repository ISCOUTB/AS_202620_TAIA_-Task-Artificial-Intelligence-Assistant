# Copiar a .env en la raíz para Compose, o pegar en Environment de Dokploy.
# Usar un host accesible DESDE el contenedor, no localhost.
# Para PostgreSQL de Dokploy: usar su nombre interno y conectar la misma red.
# Codificar caracteres especiales del usuario/password como componentes URL.
DATABASE_URL=postgresql+psycopg://taia:REEMPLAZAR_PASSWORD@REEMPLAZAR_HOST:5432/taia

# Generar un secreto aleatorio (por ejemplo: python -c "import secrets; print(secrets.token_hex(32))").
TAIA_JWT_SECRET=

# Integraciones opcionales.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TAIA_TELEGRAM_BOT_TOKEN=
TAIA_TELEGRAM_BOT_USERNAME=taia_bot

# Solo para docker-compose.local.yml.
TAIA_PORT=8000
